	partition 'public deliveries' = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "deliveries.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    Colunas = Table.SelectColumns(Cabecalhos, {"delivery_id", "delivery_order_id", "driver_id", "delivery_distance_meters", "delivery_status"}),
				    Tipos = Table.TransformColumnTypes(Colunas, {{"delivery_id", type text}, {"delivery_order_id", type text}, {"driver_id", type text}, {"delivery_distance_meters", type number}, {"delivery_status", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

