	partition 'public payments' = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "payments.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    Colunas = Table.SelectColumns(Cabecalhos, {"payment_id", "payment_order_id", "payment_amount", "payment_fee", "payment_method", "payment_status"}),
				    Tipos = Table.TransformColumnTypes(Colunas, {{"payment_id", type text}, {"payment_order_id", type text}, {"payment_amount", type number}, {"payment_fee", type number}, {"payment_method", type text}, {"payment_status", type text}}, "en-US")
				in
				    Tipos

