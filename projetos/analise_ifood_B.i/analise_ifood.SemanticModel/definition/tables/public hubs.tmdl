	partition 'public hubs' = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "hubs.csv"), [Delimiter=",", Encoding=1252, QuoteStyle=QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    Colunas = Table.SelectColumns(Cabecalhos, {"hub_id", "hub_name", "hub_city", "hub_state", "hub_latitude", "hub_longitude"}),
				    Tipos = Table.TransformColumnTypes(Colunas, {{"hub_id", type text}, {"hub_name", type text}, {"hub_city", type text}, {"hub_state", type text}, {"hub_latitude", type number}, {"hub_longitude", type number}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

