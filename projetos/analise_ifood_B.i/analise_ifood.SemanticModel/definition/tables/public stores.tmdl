	partition 'public stores' = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "stores.csv"), [Delimiter=",", Encoding=1252, QuoteStyle=QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
