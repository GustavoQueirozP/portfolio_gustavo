	partition 'public channels' = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "channels.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    Colunas = Table.SelectColumns(Cabecalhos, {"channel_id", "channel_name", "channel_type"}),
				    Tipos = Table.TransformColumnTypes(Colunas, {{"channel_id", type text}, {"channel_name", type text}, {"channel_type", type text}}, "en-US")
