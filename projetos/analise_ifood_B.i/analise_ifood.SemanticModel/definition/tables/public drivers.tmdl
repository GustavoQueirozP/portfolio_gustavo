	partition 'public drivers' = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "drivers.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    Colunas = Table.SelectColumns(Cabecalhos, {"driver_id", "driver_modal", "driver_type"}),
				    Tipos = Table.TransformColumnTypes(Colunas, {{"driver_id", type text}, {"driver_modal", type text}, {"driver_type", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

